{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/pieces/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" }
      ]
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD ':(exclude)thumbs' || exit 1; exit 0"
}
